# Review the TeamSpeak server license before changing this to accept.
TSSERVER_LICENSE_ACCEPTED=not-accepted

# Keep disabled until the native administrator exists via private bootstrap.
TS_MANAGER_PUBLIC=false
TS_MANAGER_DOMAIN=ts-manager.example.com
# Nonsecret examples for config checks only; replace both in ignored ts/.env.
JWT_SECRET=example-only-replace-with-a-long-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Set privately in ts/.env before running xray/generate.py.
# XRAY_SUBSCRIPTION_URL=https://your-provider.example/sub/...

# Roadie nicknames, home channel names, admin UIDs and music group IDs go in each
# ignored ts/data/roadie-djN/config.json. Copy its ts/roadie example and edit it.
