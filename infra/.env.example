GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_DOMAIN=monitor.example.com

# Explicit consent is required before Certbot can contact an ACME server.
ACME_EMAIL=admin@example.com
ACME_ENVIRONMENT=production
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
ACME_TERMS_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
ACME_ACCEPT_TERMS=false

# Only isolated local fixtures set lab plus a safe network-name prefix.
INGRESS_ENVIRONMENT=production
INGRESS_LAB_NETWORK_PREFIX=
